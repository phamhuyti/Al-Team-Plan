# --- Core ---
# mock | openai | anthropic | google | openrouter
AI_TEAM_PROVIDER=openai
AI_TEAM_MODEL=gpt-4o

# Per-role overrides (optional) — also configurable in .ai/config.yaml
# AI_TEAM_MANAGER_MODEL=gpt-4o
# AI_TEAM_CODER_MODEL=gpt-4o
# AI_TEAM_MANAGER_PROVIDER=openai
# AI_TEAM_CODER_PROVIDER=anthropic

# --- Provider keys ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# --- Runtime ---
AI_TEAM_DATABASE_URL=sqlite:///./.ai/ai-team.db
AI_TEAM_PROJECTS_ROOT=./projects
AI_TEAM_AUTO_APPROVE_MODERATE=false
AI_TEAM_AUTO_APPROVE_DANGEROUS=false
AI_TEAM_LOG_LEVEL=INFO

# API
AI_TEAM_API_HOST=0.0.0.0
AI_TEAM_API_PORT=8080

# Researcher web search (duckduckgo | mock | off)
AI_TEAM_WEB_SEARCH_ENABLED=true
AI_TEAM_WEB_SEARCH_BACKEND=duckduckgo
AI_TEAM_WEB_SEARCH_MAX_RESULTS=5

# Phase 8 routing (thường cấu hình trong .ai/config.yaml)
# AI_TEAM_ROUTING_ENABLED=false
# AI_TEAM_ROUTING_STRATEGY=balanced
# AI_TEAM_ROUTING_BUDGET_USD=2.0
