# --- Core ---
# mock | openai | anthropic | google | openrouter
AI_TEAM_PROVIDER=openai
AI_TEAM_MODEL=gpt-4o

# Per-role overrides (optional)
# AI_TEAM_MANAGER_MODEL=gpt-4o
# AI_TEAM_CODER_MODEL=gpt-4o

# --- Provider keys ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# --- Runtime ---
AI_TEAM_DATABASE_URL=sqlite:///./.ai/ai-team.db
AI_TEAM_PROJECTS_ROOT=./projects
AI_TEAM_AUTO_APPROVE_MODERATE=false
AI_TEAM_AUTO_APPROVE_DANGEROUS=false
AI_TEAM_LOG_LEVEL=INFO

# API
AI_TEAM_API_HOST=0.0.0.0
AI_TEAM_API_PORT=8080
